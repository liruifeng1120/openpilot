# JY60 IMU设备udev规则
# 自动为JY60设备设置适当的权限和组

# 匹配所有USB转串口设备
SUBSYSTEM=="tty", ATTRS{idVendor}=="*", ATTRS{idProduct}=="*", ATTRS{bInterfaceClass}=="ff", GROUP="dialout", MODE="0660"

# 匹配常见的USB转串口芯片
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", GROUP="dialout", MODE="0660"  # CP210x
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", GROUP="dialout", MODE="0660"  # FTDI
SUBSYSTEM=="tty", ATTRS{idVendor}=="067b", ATTRS{idProduct}=="2303", GROUP="dialout", MODE="0660"  # Prolific

# 匹配JY60设备特定的规则（如果知道具体ID）
SUBSYSTEM=="tty", ATTRS{manufacturer}=="JY60*", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ATTRS{product}=="*JY60*", GROUP="dialout", MODE="0660"

# 通用规则，为/dev/ttyUSB*设备设置权限
KERNEL=="ttyUSB[0-9]*", GROUP="dialout", MODE="0660"