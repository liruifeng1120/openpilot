[Unit]
Description=Location Daemon with JY60 IMU Support
After=multi-user.target

[Service]
Type=simple
ExecStart=/home/liruifeng/ajouatom/selfdrive/locationd/locationd --type=jy60 --device=/dev/ttyUSB0 --baud=9600
WorkingDirectory=/home/liruifeng/ajouatom
Restart=always
RestartSec=3
User=root
Group=dialout

[Install]
WantedBy=multi-user.target