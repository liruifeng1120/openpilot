FROM ubuntu:20.04

# 安装依赖
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    build-essential \
    scons \
    libzmq5-dev \
    libeigen3-dev \
    && rm -rf /var/lib/apt/lists/*

# 复制项目文件
COPY . /app
WORKDIR /app

# 安装Python依赖
RUN pip3 install -r requirements.txt

# 构建项目
RUN scons --minimal

# 创建dialout组和用户
RUN groupadd -r dialout && useradd -r -g dialout jy60user

# 切换到非root用户
USER jy60user

# 默认命令
CMD ["./selfdrive/locationd/locationd", "--type=jy60", "--device=/dev/ttyUSB0", "--baud=9600"]