# SConstruct for C++ Camera Driver
# ajouatom项目 - C++摄像头驱动SCons构建配置

import os
import subprocess

# 环境配置
env = Environment()

# 编译器和标志
env['CXX'] = 'g++'
env['CXXFLAGS'] = ['-std=c++11', '-O3', '-Wall', '-Wextra', '-fPIC']
env['CPPPATH'] = ['.']

# 源文件和目标文件
sources = ['camera_cpp.cpp']
headers = ['camera_cpp.h']
lib_target = 'camera_cpp'
test_target = 'camera_cpp_test'

# 默认目标
Default(['lib', 'test_program'])

# 编译共享库
lib = env.SharedLibrary(lib_target, sources)
env.Alias('lib', lib)

# 创建测试程序源文件的函数
def create_test_source(target, source, env):
    test_cpp_content = '''#include "camera_cpp.h"
#include <iostream>
#include <chrono>
#include <thread>

int main() {
    std::cout << "C++ Camera Driver Sync Test" << std::endl;
    std::cout << "============================" << std::endl;

    // 创建摄像头配置
    CameraCpp::CameraConfig config;
    config.width = 2592;
    config.height = 1944;
    config.fps = 20;
    config.device = "/dev/video0";
    config.mjpeg_mode = true;

    // 创建摄像头实例
    CameraCpp camera(config);

    // 测试设备连接
    std::cout << "测试设备连接..." << std::endl;
    if (!camera.test_connection()) {
        std::cout << "设备连接测试失败" << std::endl;
        return 1;
    }
    std::cout << "设备连接测试成功" << std::endl;

    // 初始化摄像头
    std::cout << "初始化摄像头..." << std::endl;
    if (!camera.initialize()) {
        std::cout << "摄像头初始化失败" << std::endl;
        return 1;
    }
    std::cout << "摄像头初始化成功" << std::endl;

    // 显示设备信息
    std::cout << "设备信息: " << camera.get_device_info() << std::endl;

    // 开始流模式
    std::cout << "开始流模式..." << std::endl;
    if (!camera.start_streaming()) {
        std::cout << "启动流模式失败" << std::endl;
        return 1;
    }

    // 同步读取帧测试
    std::cout << "同步读取测试..." << std::endl;
    for (int i = 0; i < 20; ++i) {
        auto frame = camera.read_frame();
        if (frame.valid) {
            std::cout << "Frame " << i+1 << ": "
                     << frame.width << "x" << frame.height
                     << ", size: " << frame.data.size()
                     << " bytes, timestamp: " << frame.timestamp << std::endl;
        } else {
            std::cout << "Frame " << i+1 << ": 读取失败" << std::endl;
        }
        std::this_thread::sleep_for(std::chrono::milliseconds(50));
    }

    // 停止流模式
    std::cout << "停止流模式..." << std::endl;
    camera.stop_streaming();

    std::cout << "同步模式测试完成" << std::endl;
    return 0;
}'''

    with open(str(target[0]), 'w') as f:
        f.write(test_cpp_content)
    return None

# 创建测试源文件
test_cpp = env.Command('camera_cpp_test.cpp', [], create_test_source)
env.AlwaysBuild(test_cpp)

# 编译测试程序
test_prog = env.Program(test_target, ['camera_cpp_test.cpp'] + sources)
env.Depends(test_prog, test_cpp)
env.Alias('test_program', test_prog)

# 清理目标
env.Command('clean', [], Delete([
    lib_target + env['SHLIBSUFFIX'],
    test_target + env['PROGSUFFIX'],
    'camera_cpp_test.cpp',
    '*.o'
]))

# 安装目标
def install_lib(target, source, env):
    """安装共享库到系统路径"""
    lib_file = str(source[0])
    if os.path.exists(lib_file):
        try:
            subprocess.run(['sudo', 'cp', lib_file, '/usr/local/lib/'], check=True)
            subprocess.run(['sudo', 'ldconfig'], check=True)
            print("共享库安装完成")
        except subprocess.CalledProcessError as e:
            print(f"安装失败: {e}")
    else:
        print("共享库文件不存在")
    return None

install = env.Command('install', lib, install_lib)
env.Alias('install', install)

# 测试目标
def run_test(target, source, env):
    """运行C++摄像头测试"""
    test_file = str(source[0])
    if os.path.exists(test_file):
        try:
            subprocess.run([test_file], check=True)
        except subprocess.CalledProcessError as e:
            print(f"测试失败: {e}")
    else:
        print("测试程序不存在")
    return None

test = env.Command('test', test_prog, run_test)
env.Alias('test', test)

# Python测试目标
def run_python_test(target, source, env):
    """运行Python包装器测试"""
    try:
        subprocess.run(['python3', 'camera_cpp_wrapper.py'], check=True)
    except subprocess.CalledProcessError as e:
        print(f"Python测试失败: {e}")
    return None

python_test = env.Command('test_python', lib, run_python_test)
env.Alias('test_python', python_test)

# 帮助目标
def show_help(target, source, env):
    """显示帮助信息"""
    help_text = '''C++摄像头驱动 SCons构建系统
可用目标:
  scons                - 编译所有目标（默认）
  scons lib           - 仅编译共享库
  scons test_program  - 编译测试程序
  scons test          - 运行C++测试
  scons test_python   - 运行Python测试
  scons clean         - 清理编译文件
  scons install       - 安装到系统
  scons help          - 显示此帮助

使用示例:
  scons -j4           - 使用4个并行任务编译
  scons --cache       - 使用缓存加速编译
  scons -c            - 清理所有目标
'''
    print(help_text)
    return None

help_cmd = env.Command('help', [], show_help)
env.Alias('help', help_cmd)

# 添加环境变量支持
if 'CAMERA_WIDTH' in os.environ:
    env['CPPDEFINES'] = env.get('CPPDEFINES', []) + [('CAMERA_WIDTH', os.environ['CAMERA_WIDTH'])]
if 'CAMERA_HEIGHT' in os.environ:
    env['CPPDEFINES'] = env.get('CPPDEFINES', []) + [('CAMERA_HEIGHT', os.environ['CAMERA_HEIGHT'])]
if 'CAMERA_FPS' in os.environ:
    env['CPPDEFINES'] = env.get('CPPDEFINES', []) + [('CAMERA_FPS', os.environ['CAMERA_FPS'])]

# 调试模式支持
if ARGUMENTS.get('debug', 0):
    env['CXXFLAGS'] += ['-g', '-DDEBUG']
    env['CXXFLAGS'] = [flag for flag in env['CXXFLAGS'] if flag != '-O3']
    print("调试模式已启用")

# 详细模式支持
if ARGUMENTS.get('verbose', 0):
    env['CXXFLAGS'] += ['-v']
    print("详细模式已启用")

# 检查依赖
def check_dependencies():
    """检查编译依赖"""
    required_headers = ['/usr/include/linux/videodev2.h']
    missing_deps = []

    for header in required_headers:
        if not os.path.exists(header):
            missing_deps.append(header)

    if missing_deps:
        print("警告: 缺少以下依赖:")
        for dep in missing_deps:
            print(f"  {dep}")
        print("请安装必要的开发包:")
        print("  sudo apt-get install linux-headers-$(uname -r)")

    return len(missing_deps) == 0

# 在构建前检查依赖
if not ARGUMENTS.get('help', 0) and not ARGUMENTS.get('clean', 0):
    check_dependencies()

# 进度条支持（如果可用）
try:
    from SCons.Script import Progress
    Progress('Evaluating $TARGET\n')
except ImportError:
    pass

print("ajouatom C++摄像头驱动 - SCons构建配置已加载")
print("使用 'scons help' 查看可用目标")